/** cpolyfill - Filling the gaps between C standards and compilers

    Build configuration, generated by meson when the library is built.
    Do not edit: the values must match the compiled library.

    SPDX-FileCopyrightText: 2025-2026 Предраг Јовановић
    SPDX-License-Identifier: Apache-2.0
**/

#ifndef CPOLYFILL_CONFIG_H
#define CPOLYFILL_CONFIG_H

#define PF_VERSION_MAJOR @PF_VERSION_MAJOR@
#define PF_VERSION_MINOR @PF_VERSION_MINOR@
#define PF_VERSION_PATCH @PF_VERSION_PATCH@
#define PF_VERSION_STRING "@PF_VERSION_STRING@"

/* 1 if the library was built only as a shared library (DLL on Windows). */
#define PF_CONFIG_SHARED @PF_CONFIG_SHARED@

#endif /* CPOLYFILL_CONFIG_H */
