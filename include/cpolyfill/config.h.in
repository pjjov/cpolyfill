#define PF_CONFIG_HAVE_UNSETENV @PF_CONFIG_HAVE_UNSETENV@
#define PF_CONFIG_HAVE_QSORT_R @PF_CONFIG_HAVE_QSORT_R@
#define PF_CONFIG_HAVE_STRERROR_R @PF_CONFIG_HAVE_STRERROR_R@
