/** cpolyfill - Filling the gaps between C standards and compilers

    Build configuration, generated by meson when the library is built.
    Do not edit: the values must match the compiled library.

    SPDX-FileCopyrightText: 2025-2026 Предраг Јовановић
    SPDX-License-Identifier: Apache-2.0
**/

#ifndef CPOLYFILL_CONFIG_H
#define CPOLYFILL_CONFIG_H

#define PF_VERSION_MAJOR @PF_VERSION_MAJOR@
#define PF_VERSION_MINOR @PF_VERSION_MINOR@
#define PF_VERSION_PATCH @PF_VERSION_PATCH@
#define PF_VERSION_STRING "@PF_VERSION_STRING@"

/* 1 if the library was built only as a shared library (DLL on Windows). */
#define PF_CONFIG_SHARED @PF_CONFIG_SHARED@

/* 1 if the target is big-endian (fallback for <cpolyfill/platform.h>). */
#define PF_CONFIG_BIG_ENDIAN @PF_CONFIG_BIG_ENDIAN@

/* 1 if the library was built with threads (pthreads or Win32). */
#define PF_CONFIG_THREADS @PF_CONFIG_THREADS@

/* What the C library had when cpolyfill was built: 1 if present. The
   standard-name polyfills (PF_STD_NAMES) map only the missing names.
   PF_CONFIG_HAVE_QSORT_R means qsort_r with the POSIX argument order. */
#define PF_CONFIG_HAVE_THREADS_H @PF_CONFIG_HAVE_THREADS_H@
#define PF_CONFIG_HAVE_STRINGS_H @PF_CONFIG_HAVE_STRINGS_H@
#define PF_CONFIG_HAVE_UCHAR_H @PF_CONFIG_HAVE_UCHAR_H@
