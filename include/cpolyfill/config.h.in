#define PF_CONFIG_HAVE_STRSEP @PF_CONFIG_HAVE_STRSEP@
#define PF_CONFIG_HAVE_STRCHRNUL @PF_CONFIG_HAVE_STRCHRNUL@
#define PF_CONFIG_HAVE_MEMMEM @PF_CONFIG_HAVE_MEMMEM@
#define PF_CONFIG_HAVE_MEMRCHR @PF_CONFIG_HAVE_MEMRCHR@
#define PF_CONFIG_HAVE_MEMPCPY @PF_CONFIG_HAVE_MEMPCPY@
#define PF_CONFIG_HAVE_STPCPY @PF_CONFIG_HAVE_STPCPY@
